## Control plane
# Keep the unauthenticated development endpoint local. For a remote agent,
# set this to the management host's explicit LAN address and protect it with
# TLS/authentication/firewall rules before opening the port.
CONTROL_PLANE_BIND=127.0.0.1
# Optional shared bearer token for the local first version. Set it on both
# control-plane and each agent before binding the endpoint to a LAN address.
CONTROL_PLANE_TOKEN=

## Optional infrastructure profiles (not connected to the in-memory demo yet)
POSTGRES_DB=compute_platform
POSTGRES_USER=compute
POSTGRES_PASSWORD=replace-with-a-secret
POSTGRES_BIND=127.0.0.1
NATS_CLIENT_BIND=127.0.0.1
NATS_MONITOR_BIND=127.0.0.1
MINIO_ROOT_USER=compute
MINIO_ROOT_PASSWORD=replace-with-a-secret
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-secret
KEYCLOAK_BIND=127.0.0.1
PROMETHEUS_BIND=127.0.0.1
GRAFANA_BIND=127.0.0.1
LOKI_BIND=127.0.0.1
